; SCUS_941.80: the whole game. It stays resident; everything else on the disc is data it loads.
; PSYLINK command file in the form CCPSX writes. Each `include NAME.obj` is built from src/NAME.c or
; src/NAME.s, in the original's object order, then globals.obj; the libraries are built from src/lib and
; listed in the order the original's linker read them (its startup is LIBSN's SNMAIN, pulled for the
; entry point: no 2MBYTE.OBJ precedes the code).
	org	$80010000

text	group
bss	group	bss
	section	.rdata,text
	section	.text,text
	section	.ctors,text
	section	.dtors,text
	section	.data,text
	section	.sdata,text
	section	.sbss,bss
	section	.bss,bss

